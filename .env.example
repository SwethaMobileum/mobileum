# Central PostgreSQL Database Connection String
# Replace with your Render, Railway, Neon, local PostgreSQL, or direct Supabase Postgres connection string:
# postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]
DATABASE_URL=postgresql://postgres:your_password@your_host:5432/postgres

# External Map API Key
VITE_CARTO_API_KEY=your_carto_api_key_here
